pipeline {
        agent { label "usegalaxyit_dev" }
        options { disableConcurrentBuilds() }
        environment {
                VAULT_PASS = credentials('SN06_VAULT_PASS')
                ANSIBLE_FORCE_COLOR = '1'
        }
        stages {
                stage('deploy') {
                        steps {
                                sh '''
                                python3 -m venv venv
                                . venv/bin/activate
                                python -m pip install -r requirements.txt
                                ansible-galaxy install -r requirements.yaml --force
                                ansible-playbook -i inventories/dev --vault-password-file "$VAULT_PASS" usegalaxy_it_dev.yml
                                '''
                        }
                }
        }
        post {
                failure {
                        emailext (
                        subject: '$DEFAULT_SUBJECT',
                        body: '$DEFAULT_CONTENT',
			to: "andrea.falconetti@unimi.it",
                        // to: '$DEFAULT_RECIPIENTS',
                        attachLog: true
                        )
                }
                always {
                        cleanWs()
                }
        }
}
