type: distributed
search_for_missing: true

backends:

  # Existing datasets (id-based paths, e.g. 000/dataset_136.dat).
  # weight 0: still readable, receives no new datasets.
  - id: files01
    type: disk
    store_by: id
    device: "cnr01"
    name: "CNR PowerScale storage (id=files01)"
    weight: 0
    badges:
      - type: more_stable
    files_dir: "{{ cnr.cnr01.path }}/share/datasets"
    extra_dirs:
      - type: job_work
        path: "{{ job_working_directory }}"
      - type: temp
        path: "{{ job_working_directory }}/tmp"

  # New datasets (uuid-based paths), required by metadata_strategy: extended
  # for outputs discovered at runtime (UG-022).
  - id: files02
    type: disk
    store_by: uuid
    device: "cnr01"
    name: "CNR PowerScale storage (id=files02)"
    weight: 1
    badges:
      - type: more_stable
    files_dir: "{{ cnr.cnr01.path }}/share/datasets_uuid"
    extra_dirs:
      - type: job_work
        path: "{{ job_working_directory }}"
      - type: temp
        path: "{{ job_working_directory }}/tmp"
