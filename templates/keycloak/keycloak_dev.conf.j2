# Database
db=postgres
db-url=jdbc:postgresql://postgres:5432/{{ keycloak.dev.db_name }}

# JDBC pool
db-pool-initial-size=5
db-pool-min-size=5
db-pool-max-size=20

# HTTP
http-enabled=true
http-port=8080
hostname-strict=false
hostname={{ inventory_hostname }}

# Admin user
# This is valid only to create keycloak.
bootstrap-admin-username=${KEYCLOAK_ADMIN}
bootstrap-admin-password=${KEYCLOAK_ADMIN_PASSWORD}

# Features
features=token-exchange

# HTTPS (opzionale)
#https-key-store-file=/etc/keycloak/keystore.jks
#https-key-store-password=secret

# Proxy headers
proxy-headers=xforwarded
