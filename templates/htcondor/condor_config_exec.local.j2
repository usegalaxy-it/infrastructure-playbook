#CONDOR_HOST = htcondor-cm-dev
#COLLECTOR_HOST = htcondor-cm-dev
CONDOR_HOST = {{ hostvars[groups['htcondor_cm_dev'][0]]['ansible_host'] }}
COLLECTOR_HOST = {{ hostvars[groups['htcondor_cm_dev'][0]]['ansible_host'] }}
ALLOW_WRITE = *
ALLOW_READ = $(ALLOW_WRITE)
ALLOW_ADMINISTRATOR = *
ALLOW_NEGOTIATOR = $(ALLOW_ADMINISTRATOR)
ALLOW_CONFIG = $(ALLOW_ADMINISTRATOR)
ALLOW_DAEMON = $(ALLOW_ADMINISTRATOR)
ALLOW_OWNER = $(ALLOW_ADMINISTRATOR)
ALLOW_CLIENT = *
DAEMON_LIST = MASTER, SCHEDD, STARTD
FILESYSTEM_DOMAIN = usegalaxy.it
UID_DOMAIN = usegalaxy.it
TRUST_UID_DOMAIN = True
SOFT_UID_DOMAIN = True
BASE_CGROUP = htcondor
CGROUP_MEMORY_LIMIT_POLICY = hard
RESERVED_MEMORY = 2048

# run with partitionable slots
CLAIM_PARTITIONABLE_LEFTOVERS = True
NUM_SLOTS = 1
NUM_SLOTS_TYPE_1 = 1
SLOT_TYPE_1 = 100%
SLOT_TYPE_1_PARTITIONABLE = True
ALLOW_PSLOT_PREEMPTION = False
STARTD.PROPORTIONAL_SWAP_ASSIGNMENT = True

# Galaxy tags
GalaxyTraining = {{ training }}
GalaxyGroup = "{{ group }}"
GalaxyCluster = none
GalaxyDockerHack = {{ docker_hack }}
STARTD_ATTRS = GalaxyTraining, GalaxyGroup, GalaxyCluster, GalaxyDockerHack
Rank = StringListMember(MY.GalaxyGroup, TARGET.Group)
