
module gunicorn_connect 1.0;

require {
	type amqp_port_t;
	type usr_t;
	type smtp_port_t;
	type init_t;
	type http_port_t;
	type nfs_t;
	type fusefs_t;
	type postgresql_port_t;
	class file { append create execute execute_no_trans ioctl lock map open read rename setattr unlink write };
	class lnk_file read;
	class sock_file { create setattr unlink };
	class dir { rmdir watch_reads };
	class tcp_socket name_connect;
}

#============= init_t ==============

#!!!! This avc is allowed in the current policy
allow init_t amqp_port_t:tcp_socket name_connect;

#!!!! This avc is allowed in the current policy
#!!!! This av rule may have been overridden by an extended permission av rule
allow init_t fusefs_t:file { ioctl open read };

#!!!! This avc can be allowed using the boolean 'nis_enabled'
allow init_t http_port_t:tcp_socket name_connect;

#!!!! This avc is allowed in the current policy
allow init_t nfs_t:dir { rmdir watch_reads };

#!!!! This avc is allowed in the current policy
#!!!! This av rule may have been overridden by an extended permission av rule
allow init_t nfs_t:file { append create execute execute_no_trans ioctl lock map open read rename setattr unlink write };

#!!!! This avc is allowed in the current policy
allow init_t nfs_t:lnk_file read;

#!!!! This avc is allowed in the current policy
allow init_t nfs_t:sock_file { create setattr unlink };

#!!!! This avc is allowed in the current policy
allow init_t postgresql_port_t:tcp_socket name_connect;

#!!!! This avc can be allowed using the boolean 'nis_enabled'
allow init_t smtp_port_t:tcp_socket name_connect;

#!!!! This avc is allowed in the current policy
allow init_t usr_t:file { create unlink write };
